# Backend API Configuration
# This is the initial/fallback backend URL used before system settings are loaded.
# Once a backend URL is saved via Settings, that value takes precedence.

# Local development (comment out to use Vite proxy):
# VITE_API_BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL)
# Use DATABASE_URL for a full connection string, or set individual vars below.
# Defaults match the docker-compose.yml at the repo root.
# DATABASE_URL=postgresql://cable_user:cable_secure_pass_2024@localhost:5432/cable_network
# DB_USER=cable_user
# DB_PASSWORD=cable_secure_pass_2024
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=cable_network

# API Key Authentication
# The frontend sends this as X-API-Key header; backend validates against API_KEY env var
# VITE_API_KEY=dev-api-key-change-me
# API_KEY=dev-api-key-change-me

# Slack Integration (Backend)
# Create a Slack Incoming Webhook at https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# CORS Configuration (Backend)
CORS_ORIGINS=http://localhost:8208,http://localhost:8100,http://localhost:5173,http://localhost:3000

# Claude AI (optional - enables AI analysis features)
# ANTHROPIC_API_KEY=sk-ant-...

# Backend worker count (default: 4, use 1 with RELOAD=1 for dev)
# WORKERS=4

# Data volume / generator scale (Backend)
# Each fiber node gets one KPI row every KPI_GENERATION_INTERVAL_SECONDS. The
# loop ticks every KPI_CYCLE_SECONDS and samples a rotating slice of nodes per
# tick, so the UI stays live at any interval. Defaults (7,240 nodes, 5 min,
# 30 s tick) write ~724 rows per tick and hold ~174k raw rows at 2 h retention.
# Raise the interval to write less; NODES_PER_HUB shrinks the plant itself and
# only takes effect on an empty database (the plant is seeded once).
# KPI_GENERATION_INTERVAL_SECONDS=300
# KPI_CYCLE_SECONDS=30
# NODES_PER_HUB=0              # 0 = per-area default (40) -> 7,240 nodes; 10 -> 1,810 nodes
# HISTORICAL_BACKFILL_HOURS=2  # first-boot backfill, clamped to RETENTION_RAW_HOURS
# HISTORICAL_INTERVAL_MINUTES=5
# RETENTION_RAW_HOURS=2
# RETENTION_1MIN_HOURS=6
# RETENTION_5MIN_HOURS=12
# RETENTION_HOURLY_DAYS=3
# RETENTION_DAILY_DAYS=30
# RETENTION_RESOLVED_ALERTS_DAYS=30
# RETENTION_COMPLETED_ACTIONS_DAYS=30

# Docker Compose port overrides (host ports)
# HOST_DB_PORT=5434
# HOST_BACKEND_PORT=8008
# HOST_FRONTEND_PORT=8208

# CARTO basemap (map tiles)
# API key / access token sent with tile requests (needed for authenticated CARTO accounts)
# VITE_CARTO_API_KEY=your-carto-api-key
# Style: light_all (default), dark_all, voyager, light_nolabels, dark_nolabels
# VITE_CARTO_BASEMAP=light_all
# Full tile URL override; {token} is replaced by VITE_CARTO_API_KEY
# VITE_BASEMAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?key={token}
# Docker Compose equivalents (passed as build args): CARTO_API_KEY, CARTO_BASEMAP, BASEMAP_TILE_URL

# Cloudera Agent Studio URL
# VITE_AGENT_STUDIO_URL=https://workflow-xxxxx.ml-xxxxx.cloudera.site/
