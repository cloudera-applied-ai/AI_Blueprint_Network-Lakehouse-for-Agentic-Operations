# Stage 1: Build the frontend
FROM node:22-slim AS build

WORKDIR /app

# VITE_* env vars are baked in at compile time by Vite
ARG VITE_API_KEY=dev-api-key-change-me
ENV VITE_API_KEY=$VITE_API_KEY
# CARTO basemap auth/style (see src/config/basemap.ts)
ARG VITE_CARTO_API_KEY=
ARG VITE_CARTO_BASEMAP=light_all
ARG VITE_BASEMAP_TILE_URL=
ENV VITE_CARTO_API_KEY=$VITE_CARTO_API_KEY VITE_CARTO_BASEMAP=$VITE_CARTO_BASEMAP VITE_BASEMAP_TILE_URL=$VITE_BASEMAP_TILE_URL

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy built assets
COPY --from=build /app/dist /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8100

CMD ["nginx", "-g", "daemon off;"]
